# Default: automatically detect text files and normalize to LF
* text=auto

# Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts must use LF
*.sh text eol=lf
mvnw text eol=lf

# Source code
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.pdf binary